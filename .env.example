# ---- Evolution API (v2.3.7 no Coolify, serviço "Evolution API") ----
# ATENÇÃO (levantado na VPS em 09/10/2026): a Evolution NÃO está publicada via
# Traefik e NÃO tem SSL. Ela não possui label Traefik alguma, e
# evolution.premiosistemas.dev.br tem DNS mas o Traefik responde 404/503.
# O acesso real hoje é http://<ip-do-host>:2000, em texto claro.
# Publique-a com HTTPS antes de conectar WhatsApp de cliente final: QR code,
# mensagens e a apikey global trafegariam sem TLS.
EVOLUTION_URL=https://evolution.premiosistemas.dev.br
# A key GLOBAL da instalação. Com AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
# (default em vigor lá), quem tem esta key lê a apikey de TODAS as instâncias,
# inclusive as do wpp-premio. Este app nunca chama /instance/fetchInstances.
EVOLUTION_API_KEY=apikey-global-da-evolution

# ---- api-master (login por CNPJ) ----
# Os dois domínios roteiam para a api-master (verificado no Traefik):
# api.premiosistemas.com.br e api.premiosistemas.dev.br.
MASTER_API_URL=https://api.premiosistemas.com.br/v1

# ---- MariaDB (mesmo banco do wpp-premio, tabelas client_*) ----
# DB_HOST tem de ser o NOME DO CONTAINER na rede Docker `coolify`, nunca o IP
# público do host: o MariaDB publica 1999->3306, então a porta 3306 não existe
# do lado de fora e o app morre no boot com
#   2003 (HY000): Can't connect to MySQL server on '<ip>:3306' (111)
# Na VPS de produção o valor é dd1okvvh2qnd06wgvriegkko (confira com `docker ps`).
DB_HOST=dd1okvvh2qnd06wgvriegkko
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=senha
DB_NAME=wpp_premio
# Pool enxuto: este app faz poucas consultas e precisa de pouca RAM
DB_POOL_SIZE=3

# ---- Painel ----
APP_SECRET_KEY=gere-uma-chave-aleatoria-longa
# URL pública final — é ela que vira o webhook de cada instância
PANEL_BASE_URL=https://wpp.premiosistemas.com.br
# Header x-webhook-token que a Evolution devolve nos webhooks
WEBHOOK_SECRET=gere-outro-segredo-aleatorio

# ---- Simulação de digitação ----
SIMULAR_DIGITACAO=1
# Velocidade de digitação "humana" (caracteres por segundo)
DIGITACAO_CHARS_POR_SEGUNDO=12
# Piso e teto do tempo proporcional ao texto, em segundos
DIGITACAO_MIN_S=1.5
DIGITACAO_MAX_S=25
# Adicional randômico somado sempre, em segundos
DIGITACAO_EXTRA_MIN_S=3
DIGITACAO_EXTRA_MAX_S=12

# ---- Saudação / ausência ----
# Horas de silêncio de um número antes de ele poder ser saudado de novo
SAUDACAO_JANELA_HORAS=12
# Teto de números rastreados na janela (limita a RAM do controle de repetição)
SAUDACAO_MAX_NUMEROS=20000
ATENDIMENTO_TZ=America/Sao_Paulo

# ---- Fila de envios da API ----
FILA_WORKERS=12
FILA_MAX_PENDENTES=500
# Quanto tempo o resultado de um envio fica consultável (segundos)
FILA_RESULTADO_TTL_S=900
RATE_LIMIT_POR_SEGUNDO=1

# ---- Monitor de conexão (mantém a instância 24h online) ----
MONITOR_INTERVALO_S=300
MONITOR_ATIVO=1

# ---- Log remoto na api-master (POST /v1/erros) ----
LOG_REMOTO_ATIVO=1
LOG_REMOTO_ID_SOFTWARE=21
# Envio assincrono: logar nunca bloqueia webhook nem request
LOG_REMOTO_FILA_MAX=200
# Mesma ocorrencia nao reenviada dentro desta janela (vira `qtd` no proximo envio)
LOG_REMOTO_DEDUP_S=300
# Disjuntor: apos N falhas seguidas, para de tentar por LOG_REMOTO_PAUSA_S
LOG_REMOTO_FALHAS_MAX=5
LOG_REMOTO_PAUSA_S=300
# Registra tambem os motivos de mensagem nao enviada, nao so erro tecnico
LOG_REMOTO_NAO_ENVIADAS=1

# ---- Limites ----
MAX_IMAGEM_MB=5
# Tentativas de login por IP em 5 minutos (CNPJ não é segredo)
LOGIN_TENTATIVAS_MAX=10

FLASK_DEBUG=0
